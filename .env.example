# Copie este arquivo para .env e preencha. Nunca suba o .env para o Git.

# Claude
ANTHROPIC_API_KEY=sua-chave-aqui
# Opcional: troca o modelo usado pelo agente
# ANTHROPIC_MODEL=claude-sonnet-5-5

# LangSmith (https://smith.langchain.com > Settings > API Keys)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=sua-chave-langsmith
LANGSMITH_PROJECT=calculadora
# Só se sua conta for da região EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
